# Postgres (pooler transaction-mode) usado en runtime
DATABASE_URL=
# Postgres (session-mode) usado por prisma migrate
DIRECT_URL=
# Secreto JWT: generar uno largo y aleatorio por entorno
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Origen permitido por CORS (URL de CloudFront / dominio del front, sin slash final)
FRONTEND_ORIGIN=http://localhost:4200
PORT=3000
# Token de Meta con permiso whatsapp_business_messaging; nunca incluirlo en el frontend.
WHATSAPP_ACCESS_TOKEN=
# URL HTTPS publica de la imagen para el encabezado de la plantilla aprobada.
WHATSAPP_IMAGE_URL=
# Solo para npm run create:admin
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=
